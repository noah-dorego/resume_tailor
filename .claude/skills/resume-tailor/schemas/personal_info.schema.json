{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "personal_info.json",
  "description": "Everything you could put on a resume. Store more than fits on one page; the skill selects per job.",
  "type": "object",
  "required": ["name", "contact_info", "technical_skills", "education", "work_experience"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "contact_info": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "phone": { "type": "string" },
        "location": { "type": "string", "description": "City, region. Shown in the header when present." }
      }
    },
    "links": {
      "type": "array",
      "description": "Header links, most important first. At most 3 are shown on a resume.",
      "items": { "$ref": "#/$defs/link" }
    },
    "technical_skills": {
      "type": "object",
      "description": "Grouped skills. Extra categories are allowed and are merged into the closest resume row.",
      "properties": {
        "languages": { "$ref": "#/$defs/stringList" },
        "frameworks": { "$ref": "#/$defs/stringList" },
        "infra": { "$ref": "#/$defs/stringList" },
        "dbms": { "$ref": "#/$defs/stringList" },
        "ai_tools": { "$ref": "#/$defs/stringList" },
        "os": { "$ref": "#/$defs/stringList" },
        "others": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": { "$ref": "#/$defs/stringList" }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["institution", "degree", "dates"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": "string", "minLength": 1 },
          "degree": { "type": "string", "minLength": 1, "description": "e.g. Bachelor of Science in Computer Science" },
          "minor": { "type": "string" },
          "location": { "type": "string" },
          "dates": { "$ref": "#/$defs/dateRange" },
          "gpa": { "type": "string", "description": "e.g. 3.8/4.0" },
          "coursework": { "$ref": "#/$defs/stringList" },
          "honors": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "work_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "company", "dates", "accomplishments"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "team": { "type": "string" },
          "location": { "type": "string", "description": "City, region, or Remote" },
          "dates": { "$ref": "#/$defs/dateRange" },
          "tech_stack": { "$ref": "#/$defs/stringList" },
          "accomplishments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/accomplishment" } }
        }
      }
    },
    "personal_projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "tech_stack", "accomplishments"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "description": "One-sentence context. Not printed directly." },
          "tech_stack": { "$ref": "#/$defs/stringList" },
          "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
          "dates": { "$ref": "#/$defs/dateRange" },
          "accomplishments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/accomplishment" } }
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "date": { "$ref": "#/$defs/yearMonth" },
              "skills": { "$ref": "#/$defs/stringList" },
              "pin": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "interests": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "yearMonth": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "dateRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/yearMonth" },
        "end": {
          "type": "string",
          "pattern": "^(\\d{4}-(0[1-9]|1[0-2])|present)$",
          "description": "YYYY-MM or \"present\". A future YYYY-MM is fine for expected graduation."
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "description": "e.g. LinkedIn, GitHub, Portfolio" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "accomplishment": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "skills": { "$ref": "#/$defs/stringList", "description": "Skills this bullet demonstrates. Improves job matching." },
            "metrics": { "$ref": "#/$defs/stringList", "description": "Verified numbers the skill may quote, e.g. \"p95 latency -35%\"." },
            "pin": { "type": "boolean", "description": "Always include this bullet when its entry is shown." }
          }
        }
      ]
    }
  }
}
