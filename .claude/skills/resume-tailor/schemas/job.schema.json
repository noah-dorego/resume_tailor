{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job.json",
  "description": "What the skill extracted from one job posting.",
  "type": "object",
  "required": ["source", "company", "title", "seniority", "responsibilities", "requirements", "keywords"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["method", "confidence"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "effective_url": { "type": "string" },
        "method": { "enum": ["json-ld", "page-text", "ats-api", "browser", "pasted"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "attempted": { "type": "array", "items": { "type": "string" } },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "company": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "employment_type": { "type": "string" },
    "seniority": { "enum": ["intern", "new-grad", "junior", "mid", "senior", "staff+", "unknown"] },
    "years_experience": { "type": ["number", "null"] },
    "domain": { "type": "string", "description": "Industry or product area, e.g. fintech payments" },
    "company_summary": { "type": "string" },
    "responsibilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "category", "required"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "category": { "enum": ["core-technical", "supporting-technical", "process", "soft-skill", "nice-to-have", "boilerplate"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "description": "Terms an ATS would match on, spelled exactly as the posting spells them.",
      "items": {
        "type": "object",
        "required": ["term", "priority"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["required", "preferred", "context"] },
          "category": { "enum": ["hard-skill", "soft-skill", "domain", "title"] },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "description_text": { "type": "string", "description": "Cleaned full posting text, kept for reference." }
  }
}
